# =============================================================================
# KARMETRA PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT place actual secret values in this template.
# Copy this file to .env in your secure deployment environment.
# =============================================================================

# Application Environment Mode ('production' | 'development')
APP_ENV=production
NODE_ENV=production

# -----------------------------------------------------------------------------
# PRODUCTION SUBDOMAINS & FRONTEND URLs (Safe for Browser / Netlify)
# -----------------------------------------------------------------------------
MAIN_APP_URL=https://karmetra.in
CANDIDATE_APP_URL=https://job.karmetra.in
RECRUITER_APP_URL=https://recruiter.karmetra.in
ADMIN_APP_URL=https://admin.karmetra.in

# Production API Base URL (Used by Netlify frontend to communicate with Backend)
# Example: https://api.karmetra.in or https://backend.karmetra.in/api
API_BASE_URL=
VITE_API_BASE_URL=

# Optional: Default Portal Override for dedicated Netlify Sites ('candidate' | 'employer' | 'admin' | 'main')
VITE_DEFAULT_PORTAL=

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Backend Only - NEVER expose to browser)
# -----------------------------------------------------------------------------
# PostgreSQL / Supabase / Neon / Cloud SQL Connection String
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=karmetra_production
DB_USER=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY SECRETS (Backend Only - NEVER expose to browser)
# -----------------------------------------------------------------------------
# Generate strong random strings (e.g. openssl rand -base64 32)
JWT_SECRET=
ADMIN_SECRET=

# Production Super Admin Master Account
# Set ADMIN_EMAIL and either ADMIN_PASSWORD_HASH (recommended bcrypt hash) or ADMIN_PASSWORD
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# SMS & OTP GATEWAY CONFIGURATION (Backend Only)
# -----------------------------------------------------------------------------
# Primary SMS Provider: 'fast2sms' | 'msg91' | 'twilio'
OTP_PROVIDER=fast2sms
SMS_PROVIDER=fast2sms

# In production, set to false so real OTP SMS are delivered via telecom gateway
OTP_DEMO_MODE=false

# Fast2SMS Provider Credentials
FAST2SMS_API_KEY=
FAST2SMS_OTP_TEMPLATE_ID=

# MSG91 Provider Credentials
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=KARMET

# OTP Security Parameters
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay Integration - Backend Only)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional Client-Side Key for direct Razorpay checkout bundle
VITE_RAZORPAY_KEY_ID=


# -----------------------------------------------------------------------------
# THIRD-PARTY APIS & OAUTH (Backend Only)
# -----------------------------------------------------------------------------
# Gemini AI API Key (Server-Side only)
GEMINI_API_KEY=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Maps API (For candidate & job geocoding)
MAPS_API_KEY=
